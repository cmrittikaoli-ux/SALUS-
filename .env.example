DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/salus
SALUS_TIMEZONE=Asia/Kolkata
# auto = use pg_cron if its jobs exist, else run reminder jobs inside the API; or "always" / "never"
SALUS_INTERNAL_SCHEDULER=auto
# demo mode lists sample logins on the sign-in screen; seed.py gives every seeded account this password
SALUS_DEMO_MODE=true
SALUS_DEMO_PASSWORD=salus123
